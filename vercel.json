{
    "version": 2,
    "buildCommand": "npm run build --workspace=apps/web",
    "outputDirectory": "apps/web/dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}